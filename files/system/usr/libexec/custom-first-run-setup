#!/usr/bin/bash
# Provisionamento no espaco do usuario (/var/home/$USER), executado pelo
# servico systemd --user custom-first-run.service no primeiro login.
#
# Por que aqui e nao no build da imagem: /usr e /opt sao imutaveis e
# /var/home nem existe no momento do build. iNiR, Homebrew, SDKMAN e rustup
# gerenciam suas proprias versoes dentro do HOME, logo pertencem a esta etapa.
#
# Cada etapa tem um stamp proprio: o que deu certo nunca roda de novo, o que
# falhou e tentado novamente no proximo login.
set -uo pipefail

STATE="${XDG_STATE_HOME:-${HOME}/.local/state}/custom-first-run"
mkdir -p "${STATE}" "${HOME}/.local/bin" "${HOME}/.local/share"

log() { printf '[first-run] %s\n' "$*"; }

done_with() { [[ -f "${STATE}/$1.done" ]]; }
mark_done() { touch "${STATE}/$1.done"; }

run_step() {
    local name="$1"; shift
    if done_with "${name}"; then
        log "${name}: ja provisionado"
        return 0
    fi
    log "${name}: iniciando"
    if "$@"; then
        mark_done "${name}"
        log "${name}: OK"
    else
        log "${name}: FALHOU (sera tentado no proximo login)"
    fi
}

# ---------------------------------------------------------------- Homebrew
step_homebrew() {
    local root="/home/linuxbrew/.linuxbrew"
    [[ -x "${root}/bin/brew" ]] && return 0
    # homebrew-prepare.service (root) criou o diretorio e deu a posse ao usuario.
    [[ -w "${root}" ]] || { log "homebrew: ${root} nao gravavel"; return 1; }
    git clone --depth=1 https://github.com/Homebrew/brew "${root}/Homebrew" || return 1
    ln -sf "${root}/Homebrew/bin/brew" "${root}/bin/brew"
    NONINTERACTIVE=1 HOMEBREW_NO_ENV_HINTS=1 "${root}/bin/brew" update --force --quiet || true
    "${root}/bin/brew" --version
}

# ------------------------------------------------------------------ SDKMAN
step_sdkman() {
    local dir="${HOME}/.sdkman"
    [[ -s "${dir}/bin/sdkman-init.sh" ]] && return 0
    curl -fsSL "https://get.sdkman.io?rcupdate=false" | bash || return 1
    [[ -s "${dir}/bin/sdkman-init.sh" ]]
}

# ------------------------------------------------------------------ rustup
step_rustup() {
    command -v rustc >/dev/null 2>&1 && [[ -x "${HOME}/.cargo/bin/rustc" ]] && return 0
    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile default || return 1
    "${HOME}/.cargo/bin/rustc" --version
}

# -------------------------------------------------------------------- iNiR
step_inir() {
    local repo_file="/etc/custom-inir-repo" url dir="${HOME}/.local/share/inir-repo"
    url="$(grep -vE '^\s*(#|$)' "${repo_file}" 2>/dev/null | head -n1)"
    if [[ -z "${url}" ]]; then
        log "inir: nenhuma URL em ${repo_file}"
        return 1
    fi
    if [[ -d "${dir}/.git" ]]; then
        git -C "${dir}" pull --ff-only || return 1
    else
        git clone --depth=1 "${url}" "${dir}" || return 1
    fi
    cd "${dir}" || return 1
    if [[ ! -x ./setup ]]; then
        log "inir: script './setup' nao encontrado no repositorio"
        return 1
    fi

    # O './setup' tem tres fases e duas delas exigem root:
    #
    #   1 deps    - `sudo dnf upgrade` e instalacao de pacotes
    #   2 setups  - `sudo groupadd/usermod`, /etc/modules-load.d, servicos
    #   3 files   - escreve ~/.config, roda como o proprio usuario
    #
    # Este servico roda como usuario, sem tty e sem agente de autenticacao, de
    # modo que qualquer sudo falha com "a terminal is required to read the
    # password". Pulamos 1 e 2, e o que elas fariam ja vem na imagem:
    #
    #   deps   -> lista extraida de sdata/dist-fedora/install-deps.sh e posta
    #             no modulo dnf da receita, com o COPR do quickshell 0.3
    #   setups -> grupos video/input/i2c/network em custom-setup-user-groups e
    #             /etc/modules-load.d/i2c-dev.conf
    #
    # --skip-sysupdate vai junto porque o `dnf upgrade` tambem mora na fase 1 e
    # nao existe em sistema atomico (quem atualiza e o rpm-ostree).
    #
    # Sem fallback sem --skip-deps: em Silverblue ele so reproduz a falha,
    # agora com uma caixa de senha que ninguem pode responder.
    if ! ./setup install -y --skip-deps --skip-setups --skip-sysupdate < /dev/null; then
        log "inir: './setup install' falhou; rode manualmente para ver o erro:"
        log "inir:   cd ${dir} && ./setup install --skip-deps --skip-setups --skip-sysupdate"
        return 1
    fi

    # O iNiR exige REINICIAR, nao basta relogar (doc oficial).
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "iNiR instalado" \
            "Reinicie o computador para o shell carregar. Relogar nao basta." || true
    fi
    log "inir: instalado - REINICIE a maquina para o shell subir"
}

run_step homebrew step_homebrew
run_step sdkman   step_sdkman
run_step rustup   step_rustup
run_step inir     step_inir

log "provisionamento concluido"
