# Terra (Fyra Labs) - unica fonte do Umbriel no Fedora.
#
# O iNiR roda em dois compositores, Niri e Umbriel; no Fedora o instalador
# dele adicionaria este mesmo repositorio (`inir compositor add umbriel`),
# o que exige sudo e nao roda em sistema atomico. Entao vem na imagem.
#
# Copiado de https://github.com/terrapkg/subatomic-repos/raw/main/terra.repo
# com $releasever preservado: o dnf resolve para a versao do Fedora da base.
[terra]
name=Terra $releasever
baseurl=https://repos.fyralabs.com/terra$releasever
type=rpm
skip_if_unavailable=True
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://repos.fyralabs.com/terra$releasever/key.asc
enabled=1
enabled_metadata=1
metadata_expire=4h
